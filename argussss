def search_escalations(query: str) -> list[dict[str, Any]]:
    """Search across retail, expansions, horizontal, and fincrime escalation rules."""
    q = query.strip().lower()
    if not q:
        return []
    matches: list[dict[str, Any]] = []

    for item in ESCALATIONS_DATA.get("retail_escalations", []):
        blob = json.dumps(item, ensure_ascii=False).lower()
        if q in blob:
            matches.append({"section": "retail_escalations", "entry": item})

    for key, val in ESCALATIONS_DATA.get("expansions_escalations", {}).get("country_specific", {}).items():
        if q in key.lower() or q in json.dumps(val, ensure_ascii=False).lower():
            matches.append({"section": f"expansions:{key}", "entry": val})

    for scope, topics in ESCALATIONS_DATA.get("horizontal_escalations", {}).items():
        if q in scope.lower() or q in json.dumps(topics, ensure_ascii=False).lower():
            matches.append({"section": f"horizontal:{scope}", "entry": topics})

    for team, details in ESCALATIONS_DATA.get("fincrime_escalations", {}).get("teams", {}).items():
        if q in team.lower() or q in json.dumps(details, ensure_ascii=False).lower():
            matches.append({"section": f"fincrime:{team}", "entry": details})

    return matches


